{
  "hosting": [
    {
      "target": "root",
      "redirects": [
        {
          "source": "**",
          "destination": "https://itematic.mateosarria.com",
          "type": 301
        }
      ]
    },
    {
      "target": "itematic",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}